# -----------------------------
# Phoenix / ABR — Distro-Friendly .gitignore
# -----------------------------

# JetBrains IDE (CLion, IntelliJ, etc.)
.idea/

# VS Code
.vscode/

# Build directories (CMake, Make, Ninja, etc.)
build/
cmake-build-debug/
cmake-build-release/
out/
dist/

# Autogenerated CMake files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt

# Object files
*.o
*.obj

# Compiled binaries / libraries
*.a
*.so
*.dll
*.dylib
*.exe
*.out

# Debugging / profiling
*.gcda
*.gcno
*.prof
*.pdb

# Logs / temp / cache
*.log
*.tmp
.cache/
tmp/
logs/

# Python (if tooling scripts exist)
__pycache__/
*.pyc

# Devcontainer
.devcontainer/*.log
.devcontainer/.tmp/

# OS junk
.DS_Store
Thumbs.db

